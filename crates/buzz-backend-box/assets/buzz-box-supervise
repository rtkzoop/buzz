#!/bin/sh
set -u
umask 077

state_path=/var/lib/buzz-agent/state.json
stop_intent_path=/var/lib/buzz-agent/stop-intent
invocation_path=/run/buzz-agent/invocation
image_path=/var/lib/buzz-agent/image.ref
env_path=/run/buzz-agent/env.pending
launch_authorized_path=/run/buzz-agent/launch-authorized
consumed_path=/run/buzz-agent/env-consumed
entrypoint_path=/usr/local/libexec/buzz-box-entrypoint
lock_path=/run/buzz-agent/supervisor.lock
handoff_lock_path=/run/buzz-agent/launch-handoff.lock
handoff_owner_path=$handoff_lock_path/pid
handoff_lock_acquired=0
handoff_lock_attempts=0
handoff_lock_max_attempts=120
handoff_lock_retry_seconds=1
container_name=buzz-agent
external_stop=0
signal_interrupted=0
launch_armed=0
invocation=
lock_acquired=0

# Markers are read by systemd's post-stop hook and by the next resumed VM.
# Always replace them atomically on the same filesystem. The pending env file
# is different: it is a transient secret owned by this launcher and is removed
# by the EXIT trap on every path, including preflight and lock failures.
atomic_write() {
    marker_path=$1
    marker_content=$2
    marker_tmp="${marker_path}.tmp.$$"
    if ! printf '%s\n' "$marker_content" > "$marker_tmp"; then
        rm -f -- "$marker_tmp"
        return 1
    fi
    if ! mv -f "$marker_tmp" "$marker_path"; then
        rm -f -- "$marker_tmp"
        return 1
    fi
}

# This is a short-lived launch handoff lock, not the supervisor lifetime lock.
# mkdir is the POSIX atomic acquisition operation. The PID file lets a later
# deploy or stop remove a lock left by a dead owner; retries are bounded so a
# live owner that does not exit cannot create an unbounded stop wait.
release_handoff_lock() {
    if [ "$handoff_lock_acquired" -eq 1 ]; then
        rm -f -- "$handoff_owner_path"
        rmdir "$handoff_lock_path" 2>/dev/null || true
        handoff_lock_acquired=0
    fi
}

acquire_handoff_lock() {
    handoff_lock_attempts=0
    missing_owner_attempts=0
    while [ "$handoff_lock_attempts" -lt "$handoff_lock_max_attempts" ]; do
        if mkdir "$handoff_lock_path" 2>/dev/null; then
            # Set ownership before the first operation that can fail so the
            # EXIT trap can remove the directory even during PID-file setup.
            handoff_lock_acquired=1
            if ! printf '%s\n' "$$" > "$handoff_owner_path"; then
                release_handoff_lock
                return 74
            fi
            return 0
        fi

        handoff_lock_attempts=$((handoff_lock_attempts + 1))
        owner_pid=$(cat "$handoff_owner_path" 2>/dev/null || true)
        stale_owner=0
        case "$owner_pid" in
            '')
                # A creator writes pid immediately after mkdir. Give that
                # tiny setup window one retry before treating an empty owner
                # as a crashed creator.
                missing_owner_attempts=$((missing_owner_attempts + 1))
                if [ "$missing_owner_attempts" -ge 2 ]; then
                    stale_owner=1
                fi
                ;;
            0|*[!0-9]*) stale_owner=1 ;;
            *)
                missing_owner_attempts=0
                if ! kill -0 "$owner_pid" 2>/dev/null; then
                    stale_owner=1
                fi
                ;;
        esac
        if [ "$stale_owner" -eq 1 ]; then
            rm -f -- "$handoff_owner_path"
            rmdir "$handoff_lock_path" 2>/dev/null || true
        elif [ "$handoff_lock_attempts" -lt "$handoff_lock_max_attempts" ]; then
            sleep "$handoff_lock_retry_seconds"
        fi
    done
    return 75
}

cleanup_exit() {
    release_handoff_lock
    rm -f -- "$env_path" "$launch_authorized_path"
    if [ "$lock_acquired" -eq 1 ]; then
        rmdir "$lock_path" 2>/dev/null || true
    fi
}
trap cleanup_exit EXIT

if ! mkdir "$lock_path" 2>/dev/null; then
    exit 73
fi
lock_acquired=1

invocation=$(cat "$invocation_path" 2>/dev/null || true)
image_ref=$(cat "$image_path" 2>/dev/null || true)
if [ -z "$invocation" ] || [ -z "$image_ref" ]; then
    exit 66
fi
case "$image_ref" in
    *@sha256:*) ;;
    *) exit 65 ;;
esac
digest=${image_ref##*@sha256:}
if ! printf '%s\n' "$digest" | grep -Eq '^[0-9a-f]{64}$'; then
    exit 65
fi

record_external() {
    signal_interrupted=1
    external_stop=1
    atomic_write "$stop_intent_path" external || true
    atomic_write "$state_path" "{\"invocation\":\"${invocation:-}\",\"launch_armed\":$launch_armed,\"started\":false,\"stop_intent\":\"external\"}" || true
    docker stop --time=110 "$container_name" >/dev/null 2>&1 || true
}
trap record_external TERM INT
trap 'exit 129' HUP

refuse_external() {
    rm -f -- "$env_path" "$launch_authorized_path"
    atomic_write "$state_path" "{\"invocation\":\"$invocation\",\"launch_armed\":false,\"started\":false,\"startup\":\"refused-external\",\"stop_intent\":\"external\"}" || true
    exit 67
}

prior_intent=$(cat "$stop_intent_path" 2>/dev/null || true)
authorized_nonce=$(cat "$launch_authorized_path" 2>/dev/null || true)

# A resumed enabled unit must never infer a new launch from disk state. A
# matching launch-authorized nonce is the only explicit-start capability. This
# covers prior self and external intent, and also the no-marker resume race.
if [ "$authorized_nonce" != "$invocation" ]; then
    case "$prior_intent" in
        self|external)
            # A prior intentional or external stop is never relaunched
            # without a matching fresh authorization marker.
            atomic_write "$stop_intent_path" refused-not-armed || true
            atomic_write "$state_path" "{\"invocation\":\"$invocation\",\"launch_armed\":false,\"started\":false,\"startup\":\"refused-not-armed\",\"stop_intent\":\"refused-not-armed\"}" || true
            exit 67
            ;;
        *)
            # Even a missing prior intent is not enough during resume. This
            # is the enabled-unit versus provisioner race guard.
            atomic_write "$stop_intent_path" refused-not-armed || true
            atomic_write "$state_path" "{\"invocation\":\"$invocation\",\"launch_armed\":false,\"started\":false,\"startup\":\"refused-not-armed\",\"stop_intent\":\"refused-not-armed\"}" || true
            exit 67
            ;;
    esac
fi
# External stop wins over a matching authorization. The authorization is a
# capability, not permission to override an already-recorded external stop.
if [ "$prior_intent" = external ]; then
    refuse_external
fi
rm -f -- "$launch_authorized_path"
launch_armed=1

# The authorization was consumed above. Re-read the external fence before
# doing any launch work so an ExecStop racing the consume cannot authorize a
# new Docker child.
if [ "$(cat "$stop_intent_path" 2>/dev/null || true)" = external ]; then
    refuse_external
fi

atomic_write "$state_path" "{\"invocation\":\"$invocation\",\"launch_armed\":true,\"started\":false,\"startup\":\"armed\",\"stop_intent\":\"none\"}" || exit 66

if [ "$(stat -c '%u:%g:%a' "$env_path" 2>/dev/null || true)" != 0:0:600 ]; then
    exit 66
fi
if ! grep -Fq '"BUZZ_MANAGED_AGENT_START_NONCE":"'"$invocation"'"' "$env_path"; then
    exit 66
fi
if ! docker image inspect --format '{{range .RepoDigests}}{{println .}}{{end}}' "$image_ref" 2>/dev/null | grep -Fqx "$image_ref"; then
    exit 66
fi

: > "$consumed_path"
chmod 666 "$consumed_path"
docker rm -f "$container_name" >/dev/null 2>&1 || true

# The handoff lock is deliberately held only across the final check and the
# docker run spawn. This is the linearization point for launch versus
# external-stop: if external-stop acquires first, this check sees external and
# no child is created; if supervisor acquires first, the child may be created,
# and external-stop acquires next and immediately stops that child. It is not
# a promise that a launch-winning process can never be created.
if ! acquire_handoff_lock; then
    exit 74
fi
if [ "$(cat "$stop_intent_path" 2>/dev/null || true)" = external ]; then
    refuse_external
fi

docker run --name "$container_name" \
    --mount type=tmpfs,dst=/run/buzz-agent,tmpfs-mode=700 \
    --mount type=bind,src="$env_path",dst=/run/buzz-agent/env.pending,ro \
    --mount type=bind,src="$consumed_path",dst=/run/buzz-agent/env-consumed,rw \
    --mount type=bind,src="$entrypoint_path",dst=/usr/local/libexec/buzz-box-entrypoint,ro \
    "$image_ref" /usr/local/libexec/buzz-box-entrypoint /run/buzz-agent/env.pending &
child=$!
release_handoff_lock

ready=0
attempt=0
while [ "$attempt" -lt 120 ]; do
    if [ -f "$consumed_path" ] && grep -Fqx consumed "$consumed_path"; then
        ready=1
        break
    fi
    if ! kill -0 "$child" 2>/dev/null; then
        break
    fi
    sleep 1
    attempt=$((attempt + 1))
done
rm -f -- "$env_path"

child_status=0
while :; do
    wait "$child"
    child_status=$?
    if [ "$child_status" -gt 128 ] && [ "$signal_interrupted" -eq 1 ]; then
        signal_interrupted=0
        continue
    fi
    break
done
if [ "$external_stop" -eq 1 ] || [ "$(cat "$stop_intent_path" 2>/dev/null || true)" = external ]; then
    docker rm -f "$container_name" >/dev/null 2>&1 || true
    exit 0
fi

if [ "$ready" -eq 1 ]; then
    started=true
    startup=ready
else
    started=false
    startup=broken
fi
atomic_write "$state_path" "{\"invocation\":\"$invocation\",\"launch_armed\":true,\"started\":$started,\"startup\":\"$startup\",\"stop_intent\":\"self\",\"child_status\":$child_status}" || true
atomic_write "$stop_intent_path" self || true
docker rm "$container_name" >/dev/null 2>&1 || true
box stop self >/dev/null 2>&1 || true
exit "$child_status"
