#!/bin/sh
set -eu
umask 077

state_path=/var/lib/buzz-agent/state.json
stop_intent_path=/var/lib/buzz-agent/stop-intent
launch_authorized_path=/run/buzz-agent/launch-authorized

atomic_write() {
    marker_path=$1
    marker_content=$2
    marker_tmp="${marker_path}.tmp.$$"
    if printf '%s\n' "$marker_content" > "$marker_tmp"; then
        :
    else
        status=$?
        rm -f -- "$marker_tmp" || true
        return "$status"
    fi
    if mv -f "$marker_tmp" "$marker_path"; then
        :
    else
        status=$?
        rm -f -- "$marker_tmp" || true
        return "$status"
    fi
}

# This helper runs before systemd stops the launcher. It fences the
# post-stop hook from treating an owner-requested stop as a crash.
atomic_write "$stop_intent_path" external
rm -f -- "$launch_authorized_path"
atomic_write "$state_path" '{"launch_armed":false,"started":false,"stop_intent":"external"}'
docker stop --time=110 buzz-agent >/dev/null 2>&1 || true
